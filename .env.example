SECRET_KEY=change-this-to-a-random-32-plus-character-string

# The URL your reverse proxy serves the frontend from, e.g. https://learn.example.com
# Multiple origins can be comma-separated. Direct VM/LXC deployments also use
# these URLs to allow the corresponding hostnames in the Vite development server.
CORS_ORIGINS=http://localhost:4173

# Optional: additional bare hostnames for Vite, comma-separated. Normally leave
# this empty because hostnames are derived automatically from CORS_ORIGINS.
VITE_ALLOWED_HOSTS=
